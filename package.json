{
  "name": "quietmarkdown",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "A private, local-first Markdown editor with a watermark-first export studio (PDF, HTML, PNG pages).",
  "keywords": [
    "markdown",
    "markdown-editor",
    "local-first",
    "offline",
    "pwa",
    "pdf-export",
    "export",
    "privacy",
    "writing"
  ],
  "homepage": "https://quietmarkdown.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamVhavle/QuietMarkdown.git"
  },
  "bugs": {
    "url": "https://github.com/GautamVhavle/QuietMarkdown/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gautam Vhavle",
    "url": "https://gautamvhavle.xyz/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "dompurify": "latest",
    "framer-motion": "^13.2.0",
    "highlight.js": "latest",
    "jszip": "^3.10.2",
    "lucide-react": "latest",
    "markdown-it": "latest",
    "markdown-it-task-lists": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
